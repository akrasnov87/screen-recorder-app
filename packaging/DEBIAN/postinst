#!/bin/bash
set -e

VENV_DIR="/opt/screen-recorder/venv"
APP_DIR="/usr/share/screen-recorder"

case "$1" in
    configure)
        echo "Создаю виртуальное окружение..."
        python3 -m venv "$VENV_DIR"

        echo "Устанавливаю Python-зависимости..."
        "$VENV_DIR/bin/pip" install --upgrade pip wheel

        if [ -f "$APP_DIR/requirements.txt" ]; then
            "$VENV_DIR/bin/pip" install -r "$APP_DIR/requirements.txt"
        else
            "$VENV_DIR/bin/pip" install \
                PySide6 aiohttp keyring cryptography \
                python-docx pypdf pynput
        fi

        # Разрешаем доступ к микрофону через pulse (для не-root)
        if [ -f /usr/share/polkit-1/actions/org.freedesktop.policykit.policy ]; then
            :
        fi

        echo "Screen Recorder установлен."
        echo "Запуск: screen-recorder"
        ;;
esac

exit 0