#!/bin/bash
# postinst — действия после установки пакета.
set -e

# ---- Обновление баз данных .desktop и иконок -------------------------------
if command -v update-desktop-database &>/dev/null; then
    update-desktop-database -q /usr/share/applications || true
fi
if command -v gtk-update-icon-cache &>/dev/null; then
    gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor || true
fi

# ---- Создание каталогов конфигурации пользователя --------------------------
# Файл конфигурации создаётся самим приложением при первом запуске.
# Но можно заранее создать родительский каталог.
USER_HOME="${HOME:-/root}"
CONFIG_DIR="${USER_HOME}/.config/screen-recorder"
if [ -d "${USER_HOME}" ]; then
    mkdir -p "${CONFIG_DIR}" 2>/dev/null || true
    chmod 700 "${CONFIG_DIR}" 2>/dev/null || true
fi

# ---- Проверка наличия ffmpeg (предупреждение, не ошибка) -------------------
if ! command -v ffmpeg &>/dev/null; then
    echo "Внимание: ffmpeg не найден. Установите его:"
    echo "    sudo apt install ffmpeg"
fi

# ---- Готово ----------------------------------------------------------------
echo "Screen Recorder установлен. Запуск:"
echo "    screen-recorder           (консоль)"
echo "    screen-recorder-gui       (GUI, без консоли)"
echo "или через меню приложений."
exit 0