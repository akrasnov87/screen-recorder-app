/* ============================================================
   Screen Recorder — styles.qss
   ============================================================ */

QWidget {
    background-color: palette(window);
    color: palette(windowText);
    font-size: 13px;
}

/* ---------- Кнопки ---------- */
QPushButton {
    background-color: palette(button);
    border: 1px solid palette(mid);
    border-radius: 6px;
    padding: 6px 12px;
    min-height: 24px;
}

QPushButton:hover {
    background-color: palette(light);
}

QPushButton:pressed {
    background-color: palette(dark);
}

/* ---------- Текстовые поля и спинбоксы ---------- */
QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: palette(base);
    color: palette(text);
    border: 1px solid palette(mid);
    border-radius: 4px;
    padding: 4px 6px;
    min-height: 22px;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border-color: palette(highlight);
}

QSpinBox, QDoubleSpinBox {
    background-color: palette(base);
    color: palette(text);
    border: 1px solid palette(mid);
    border-radius: 4px;
    padding: 4px 6px;
    min-height: 22px;
}

QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: palette(highlight);
}

QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 18px;
    border-left: 1px solid palette(mid);
    border-bottom: 1px solid palette(mid);
    border-top-right-radius: 4px;
    background-color: palette(button);
}

QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 18px;
    border-left: 1px solid palette(mid);
    border-bottom-right-radius: 4px;
    background-color: palette(button);
}

QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: palette(light);
}

QSpinBox::up-button:pressed, QDoubleSpinBox::up-button:pressed,
QSpinBox::down-button:pressed, QDoubleSpinBox::down-button:pressed {
    background-color: palette(dark);
}

QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    image: url(resources/icons/arrow_up.svg);
    width: 8px;
    height: 6px;
}

QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    image: url(resources/icons/arrow_down.svg);
    width: 8px;
    height: 6px;
}

/* ---------- QComboBox ---------- */
QComboBox {
    background-color: #ffffff;
    color: #222222;
    border: 1px solid #b0b0b0;
    border-radius: 4px;
    padding: 4px 8px;
    min-height: 22px;
}

QComboBox:hover {
    border-color: #7a7a7a;
}

QComboBox:focus {
    border-color: #2d89ef;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 22px;
    border-left: 1px solid #b0b0b0;
    background-color: #ececec;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
}

QComboBox::down-arrow {
    image: url(resources/icons/chevron_down.svg);
    width: 10px;
    height: 6px;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #222222;
    border: 1px solid #b0b0b0;
    border-radius: 4px;
    padding: 2px;
    selection-background-color: #2d89ef;
    selection-color: #ffffff;
    outline: none;
}

QComboBox QAbstractItemView::item {
    min-height: 22px;
    padding: 4px 8px;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #2d89ef;
    color: #ffffff;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #e0e0e0;
}

/* ---------- QTabWidget ---------- */
QTabWidget::pane {
    border: 1px solid palette(mid);
    border-radius: 6px;
}

QTabBar::tab {
    padding: 8px 16px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}

QTabBar::tab:selected {
    background-color: palette(highlight);
    color: palette(highlightedText);
}

/* ---------- QProgressBar ---------- */
QProgressBar {
    border: 1px solid palette(mid);
    border-radius: 4px;
    text-align: center;
}

QProgressBar::chunk {
    background-color: palette(highlight);
    border-radius: 3px;
}
/* ===================================================================== */
/* Таблицы и деревья — единый стиль для всего приложения                 */
/* ===================================================================== */

QTableWidget,
QTableView,
QTreeWidget,
QTreeView {
    background-color: #FFFFFF;
    alternate-background-color: #F5F5F5;
    color: palette(text);
    gridline-color: #E0E0E0;          /* тонкие светлые линии сетки */
    border: 1px solid #D0D0D0;        /* тонкая светлая внешняя рамка */
    border-radius: 4px;
    selection-background-color: #2D7FF9;
    selection-color: #FFFFFF;
    outline: none;
    font-size: 11px;
}

QTableWidget,
QTableView {
    show-decoration-selected: 1;
}

QTableWidget::item,
QTableView::item,
QTreeWidget::item,
QTreeView::item {
    padding: 3px 6px;
    margin: 0;
    border: none;
    /* Убрано color: palette(text), чтобы разрешить перекраску статусов */
}

QTableWidget::item:alternate,
QTableView::item:alternate,
QTreeWidget::item:alternate,
QTreeView::item:alternate {
    background-color: #F5F5F5;        /* мягкое чередование строк */
}

QTableWidget::item:hover,
QTableView::item:hover,
QTreeWidget::item:hover,
QTreeView::item:hover {
    background-color: rgba(45, 127, 249, 30);
}

QTableWidget::item:selected,
QTableView::item:selected,
QTreeWidget::item:selected,
QTreeView::item:selected {
    background-color: #2D7FF9;
    color: #FFFFFF;
}

QTableWidget::item:selected:!active,
QTableView::item:selected:!active,
QTreeWidget::item:selected:!active,
QTreeView::item:selected:!active {
    background-color: #7EB0F2;
    color: #FFFFFF;
}

QHeaderView {
    background-color: #EDEDED;
}

QHeaderView::section {
    background-color: #EDEDED;
    color: palette(window-text);
    padding: 4px 8px;
    border: none;
    border-right: 1px solid #D0D0D0;   /* тонкая граница заголовков */
    border-bottom: 1px solid #D0D0D0;
    font-weight: bold;
}

QHeaderView::section:hover {
    background-color: #D8E8F8;
}

QHeaderView::section:first {
    border-top-left-radius: 4px;
}

QHeaderView::section:last {
    border-top-right-radius: 4px;
}

QTableCornerButton::section {
    background-color: #EDEDED;
    border: none;
    border-right: 1px solid #D0D0D0;
    border-bottom: 1px solid #D0D0D0;
}

QTableWidget QScrollBar:vertical,
QTableView QScrollBar:vertical,
QTreeWidget QScrollBar:vertical,
QTreeView QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
}

QTableWidget QScrollBar:horizontal,
QTableView QScrollBar:horizontal,
QTreeWidget QScrollBar:horizontal,
QTreeView QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 0;
}

/* Стили для колонки статуса в таблице поручений */
QTableWidget::item[status="created"] {
    background-color: rgba(21, 101, 192, 40); /* синий */
    color: #1565C0;
    font-weight: bold;
}
QTableWidget::item[status="in_progress"] {
    background-color: rgba(239, 108, 0, 40); /* оранжевый */
    color: #EF6C00;
    font-weight: bold;
}
QTableWidget::item[status="waiting"] {
    background-color: rgba(123, 31, 162, 40); /* фиолетовый */
    color: #7B1FA2;
    font-weight: bold;
}
QTableWidget::item[status="done"] {
    background-color: rgba(46, 125, 50, 40); /* зеленый */
    color: #2E7D32;
    font-weight: bold;
}
QTableWidget::item[status="cancelled"] {
    background-color: rgba(117, 117, 117, 40); /* серый */
    color: #757575;
    font-weight: bold;
}

/* ===================================================================== */
/* Исправление отображения календаря (QCalendarWidget)                   */
/* ===================================================================== */

/* Задаем минимальный размер самому календарю, чтобы влезло 6 недель */
QCalendarWidget {
    min-width: 320px;
    min-height: 280px;
}

/* Убираем жесткие рамки и задаем комфортный размер ячейки */
QCalendarWidget QAbstractItemView {
    outline: 0;
    selection-background-color: #2D7FF9;
    selection-color: #FFFFFF;
}

QCalendarWidget QAbstractItemView:enabled {
    font-size: 13px; /* Чуть увеличили шрифт для читаемости */
    color: #333333;
}

/* Убираем глобальные padding-и от QTableView, которые ломают сетку */
QCalendarWidget QTableView::item {
    padding: 0px;
    margin: 0px;
    min-width: 36px;  /* Ширина ячейки */
    min-height: 30px; /* Высота ячейки — это решит проблему обрезки */
    border: none;
}

/* Стилизация навигационной панели (месяц, год, стрелки) */
QCalendarWidget QWidget#qt_calendar_navigationbar {
    background-color: #F0F0F0;
    border-bottom: 1px solid #CCCCCC;
    min-height: 36px;
}

QCalendarWidget QToolButton {
    color: #333333;
    background-color: transparent;
    border: none;
    border-radius: 4px;
    padding: 4px;
}

QCalendarWidget QToolButton:hover {
    background-color: #E0E0E0;
}

QCalendarWidget QToolButton::menu-indicator {
    image: none;
}

/* Кнопка "сегодня" (если она есть в локали) */
QCalendarWidget QToolButton#qt_calendar_today_button {
    padding: 2px 8px;
    background-color: #E0E0E0;
    font-weight: bold;
}

/* Фикс для дней недели (заголовки) */
QCalendarWidget QWidget {
    alternate-background-color: #FFFFFF;
}